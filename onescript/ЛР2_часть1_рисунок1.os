// Лабораторная работа №2. Часть 1.
// Алгоритм рисунка 1 и тесты методов структурного покрытия.
// Ожидаемый результат считается по правильной схеме (рис. 1, а),
// фактический — по схеме с внесенными ошибками (рис. 1, б).

#Область СлужебныеПроцедурыИФункции

// Алгоритм по рис. 1, а.
Функция ВычислитьПоПравильнойСхеме(Знач A, Знач B, Знач X)

	Если A > 1 И B = 0 Тогда
		X = X / A;
	КонецЕсли;

	Если A = 2 ИЛИ X > 1 Тогда
		X = X + 1;
	КонецЕсли;

	Возврат X;

КонецФункции

// Алгоритм по рис. 1, б: "И" заменено на "ИЛИ", "X > 1" — на "X < 1".
Функция ВычислитьПоСхемеСОшибкой(Знач A, Знач B, Знач X)

	Если A > 1 ИЛИ B = 0 Тогда
		X = X / A;
	КонецЕсли;

	Если A = 2 ИЛИ X < 1 Тогда
		X = X + 1;
	КонецЕсли;

	Возврат X;

КонецФункции

Функция ПолучитьРезультат(Знач ЭтоСхемаСОшибкой, Знач A, Знач B, Знач X)

	Попытка
		Если ЭтоСхемаСОшибкой Тогда
			Результат = ВычислитьПоСхемеСОшибкой(A, B, X);
		Иначе
			Результат = ВычислитьПоПравильнойСхеме(A, B, X);
		КонецЕсли;
	Исключение
		Возврат "ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;

	Возврат "X = " + Строка(Окр(Результат, 4));

КонецФункции

Функция НовыйТест(Метод, A, B, X)

	Возврат Новый Структура("Метод, A, B, X", Метод, A, B, X);

КонецФункции

Функция ПолучитьТесты()

	Тесты = Новый Массив;

	Тесты.Добавить(НовыйТест("Покрытие операторов", 2, 0, 3));

	Тесты.Добавить(НовыйТест("Покрытие решений", 3, 0, 2));
	Тесты.Добавить(НовыйТест("Покрытие решений", 2, 1, 1));

	Тесты.Добавить(НовыйТест("Покрытие условий", 2, 0, 4));
	Тесты.Добавить(НовыйТест("Покрытие условий", 1, 1, 0));

	Тесты.Добавить(НовыйТест("Покрытие решений/условий", 2, 0, 4));
	Тесты.Добавить(НовыйТест("Покрытие решений/условий", 3, 1, 0));
	Тесты.Добавить(НовыйТест("Покрытие решений/условий", 0, 0, 0));
	Тесты.Добавить(НовыйТест("Покрытие решений/условий", 0, 0, 2));

	Тесты.Добавить(НовыйТест("Комбинаторное покрытие условий", 2, 0, 4));
	Тесты.Добавить(НовыйТест("Комбинаторное покрытие условий", 2, 1, 1));
	Тесты.Добавить(НовыйТест("Комбинаторное покрытие условий", 0.5, 0, 2));
	Тесты.Добавить(НовыйТест("Комбинаторное покрытие условий", 1, 0, 1));

	Возврат Тесты;

КонецФункции

Процедура ВыполнитьТесты() Экспорт

	Сообщить("ЛР2, часть 1. Тестирование алгоритма рисунка 1 (язык 1С)");
	Сообщить("Результат ""Успешно"" — тест обнаружил ошибку, ""Неуспешно"" — не обнаружил.");
	Сообщить("");

	КоличествоОбнаруженных = 0;
	Тесты = ПолучитьТесты();

	Для Каждого Тест Из Тесты Цикл

		Ожидаемый = ПолучитьРезультат(Ложь, Тест.A, Тест.B, Тест.X);
		Фактический = ПолучитьРезультат(Истина, Тест.A, Тест.B, Тест.X);

		ОшибкаОбнаружена = (Ожидаемый <> Фактический);
		Если ОшибкаОбнаружена Тогда
			КоличествоОбнаруженных = КоличествоОбнаруженных + 1;
		КонецЕсли;

		Сообщить(СтрШаблон("%1 | A = %2; B = %3; X = %4 | ожидаемый: %5 | фактический: %6 | %7",
			Тест.Метод, Тест.A, Тест.B, Тест.X, Ожидаемый, Фактический,
			?(ОшибкаОбнаружена, "Успешно", "Неуспешно")));

	КонецЦикла;

	Сообщить("");
	Сообщить(СтрШаблон("Всего тестов: %1, обнаружили ошибку: %2", Тесты.Количество(), КоличествоОбнаруженных));

КонецПроцедуры

#КонецОбласти

ВыполнитьТесты();
