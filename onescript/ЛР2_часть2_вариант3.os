// Лабораторная работа №2. Часть 2. Вариант 3.
// Z = Sin(X1), Cos(X2), Tg|X3| или 0 в зависимости от среднего Xср.
// Ветки блок-схемы:
//   a — ввод X1, X2, X3 и вычисление Xср;
//   b — X1 <= Xср ложно  -> Z = Sin(X1);
//   c — X1 <= Xср истинно;
//   d — X2 <= Xср ложно  -> Z = Cos(X2);
//   e — X2 <= Xср истинно;
//   f — X3 <= Xср ложно  -> Z = Tg|X3|;
//   g — X3 <= Xср истинно -> Z = 0;
//   h — вывод Z.

#Область СлужебныеПроцедурыИФункции

Функция СреднееЗначение(Знач X1, Знач X2, Знач X3)

	Возврат (X1 + X2 + X3) / 3;

КонецФункции

// В языке 1С нет встроенной функции модуля числа.
Функция МодульЧисла(Знач Число)

	Возврат ?(Число < 0, -Число, Число);

КонецФункции

// Исходная версия — строго по блок-схеме варианта 3.
// Параметр Ветка передается по ссылке и возвращает пройденный путь.
Функция ВычислитьZ(Знач X1, Знач X2, Знач X3, Ветка)

	Xср = СреднееЗначение(X1, X2, X3);

	Если X1 <= Xср Тогда
		Если X2 <= Xср Тогда
			Если X3 <= Xср Тогда
				Ветка = "a-c-e-g-h";
				Z = 0;
			Иначе
				Ветка = "a-c-e-f-h";
				Z = Tan(МодульЧисла(X3));
			КонецЕсли;
		Иначе
			Ветка = "a-c-d-h";
			Z = Cos(X2);
		КонецЕсли;
	Иначе
		Ветка = "a-b-h";
		Z = Sin(X1);
	КонецЕсли;

	Возврат Z;

КонецФункции

// Исправленная версия: проверка типа исходных данных и области определения тангенса.
Функция ВычислитьZИсправленно(Знач X1, Знач X2, Знач X3, Ветка)

	Если ТипЗнч(X1) <> Тип("Число") ИЛИ ТипЗнч(X2) <> Тип("Число") ИЛИ ТипЗнч(X3) <> Тип("Число") Тогда
		ВызватьИсключение "Исходные данные должны быть числами";
	КонецЕсли;

	Xср = СреднееЗначение(X1, X2, X3);

	Если X1 <= Xср Тогда
		Если X2 <= Xср Тогда
			Если X3 <= Xср Тогда
				Ветка = "a-c-e-g-h";
				Z = 0;
			Иначе
				Ветка = "a-c-e-f-h";
				Если МодульЧисла(Cos(МодульЧисла(X3))) < 0.000000001 Тогда
					ВызватьИсключение "Tg|X3| не определен (Cos|X3| = 0)";
				КонецЕсли;
				Z = Tan(МодульЧисла(X3));
			КонецЕсли;
		Иначе
			Ветка = "a-c-d-h";
			Z = Cos(X2);
		КонецЕсли;
	Иначе
		Ветка = "a-b-h";
		Z = Sin(X1);
	КонецЕсли;

	Возврат Z;

КонецФункции

Функция ПредставлениеРезультата(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат "Z = " + Строка(Окр(Значение, 6));
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ПолучитьРезультат(Знач ЭтоИсправленнаяВерсия, Знач X1, Знач X2, Знач X3, Ветка)

	Ветка = "—";
	Попытка
		Если ЭтоИсправленнаяВерсия Тогда
			Z = ВычислитьZИсправленно(X1, X2, X3, Ветка);
		Иначе
			Z = ВычислитьZ(X1, X2, X3, Ветка);
		КонецЕсли;
	Исключение
		Возврат "Ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;

	Возврат ПредставлениеРезультата(Z);

КонецФункции

Функция НовыйТест(Номер, Назначение, X1, X2, X3, ОжидаемаяВетка, ОжидаемоеЗначение)

	Тест = Новый Структура;
	Тест.Вставить("Номер", Номер);
	Тест.Вставить("Назначение", Назначение);
	Тест.Вставить("X1", X1);
	Тест.Вставить("X2", X2);
	Тест.Вставить("X3", X3);
	Тест.Вставить("ОжидаемаяВетка", ОжидаемаяВетка);
	Тест.Вставить("ОжидаемыйРезультат", ПредставлениеРезультата(ОжидаемоеЗначение));
	Возврат Тест;

КонецФункции

Функция ПолучитьТесты()

	Тесты = Новый Массив;

	Тесты.Добавить(НовыйТест(1, "ветка b: Sin(X1)", 5, 1, 3, "a-b-h", -0.958924));
	Тесты.Добавить(НовыйТест(2, "ветка d: Cos(X2)", 1, 5, 3, "a-c-d-h", 0.283662));
	Тесты.Добавить(НовыйТест(3, "ветка f: Tg|X3|", 1, 2, 6, "a-c-e-f-h", -0.291006));
	Тесты.Добавить(НовыйТест(4, "ветка g: Z = 0", 2, 2, 2, "a-c-e-g-h", 0));
	Тесты.Добавить(НовыйТест(5, "граница X1 = Xср", 2, 1, 3, "a-c-e-f-h", -0.142547));
	Тесты.Добавить(НовыйТест(6, "граница X2 = Xср", -3, 0, 3, "a-c-e-f-h", -0.142547));
	Тесты.Добавить(НовыйТест(7, "модуль |X3| при X3 < 0", -6, -5, -1, "a-c-e-f-h", 1.557408));
	Тесты.Добавить(НовыйТест(8, "ветка g при почти равных X", 2, 2, 2.000001, "a-c-e-f-h", -2.185034));
	Тесты.Добавить(НовыйТест(9, "Tg|X3| при |X3| = Pi/2", 0, 0, 1.5707963267949, "a-c-e-f-h",
		"Ошибка: Tg|X3| не определен (Cos|X3| = 0)"));
	Тесты.Добавить(НовыйТест(10, "нечисловые данные", "а", 1, 3, "—",
		"Ошибка: Исходные данные должны быть числами"));

	Возврат Тесты;

КонецФункции

Процедура ВыполнитьТестыВерсии(Знач ЭтоИсправленнаяВерсия)

	Если ЭтоИсправленнаяВерсия Тогда
		Сообщить("=== Исправленная версия программы ===");
	Иначе
		Сообщить("=== Исходная версия программы (строго по блок-схеме) ===");
	КонецЕсли;

	КоличествоОбнаруженных = 0;
	Тесты = ПолучитьТесты();

	Для Каждого Тест Из Тесты Цикл

		Ветка = "";
		Фактический = ПолучитьРезультат(ЭтоИсправленнаяВерсия, Тест.X1, Тест.X2, Тест.X3, Ветка);

		ОшибкаОбнаружена = (Фактический <> Тест.ОжидаемыйРезультат)
			ИЛИ (Ветка <> Тест.ОжидаемаяВетка);
		Если ОшибкаОбнаружена Тогда
			КоличествоОбнаруженных = КоличествоОбнаруженных + 1;
		КонецЕсли;

		Сообщить(СтрШаблон("Тест %1 (%2) | X1 = %3; X2 = %4; X3 = %5 | ветка %6 | ожидаемый: %7 | фактический: %8 | %9",
			Тест.Номер, Тест.Назначение, Тест.X1, Тест.X2, Тест.X3, Ветка,
			Тест.ОжидаемыйРезультат, Фактический, ?(ОшибкаОбнаружена, "Успешно", "Неуспешно")));

	КонецЦикла;

	Сообщить(СтрШаблон("Всего тестов: %1, обнаружили ошибку: %2", Тесты.Количество(), КоличествоОбнаруженных));
	Сообщить("");

КонецПроцедуры

Процедура ВыполнитьТесты() Экспорт

	Сообщить("ЛР2, часть 2, вариант 3. Тестирование методом ""белого ящика"" (язык 1С)");
	Сообщить("Результат ""Успешно"" — тест обнаружил ошибку, ""Неуспешно"" — не обнаружил.");
	Сообщить("");

	ВыполнитьТестыВерсии(Ложь);
	ВыполнитьТестыВерсии(Истина);

КонецПроцедуры

#КонецОбласти

ВыполнитьТесты();
