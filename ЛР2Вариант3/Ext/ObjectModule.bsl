#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Лабораторная работа №2. Выявление и устранение ошибок программного кода.
// Часть 1 — алгоритм рисунка 1 (правильная схема и схема с внесенными ошибками).
// Часть 2 — вариант 3: Z = Sin(X1), Cos(X2), Tg|X3| или 0 в зависимости от среднего Xср.
// Ветки блок-схемы варианта 3:
//   a — ввод X1, X2, X3 и вычисление Xср;
//   b — X1 <= Xср ложно  -> Z = Sin(X1);
//   c — X1 <= Xср истинно;
//   d — X2 <= Xср ложно  -> Z = Cos(X2);
//   e — X2 <= Xср истинно;
//   f — X3 <= Xср ложно  -> Z = Tg|X3|;
//   g — X3 <= Xср истинно -> Z = 0;
//   h — вывод Z.

#Область ПрограммныйИнтерфейс

// Среднее значение трех чисел (подпрограмма Xср блок-схемы).
Функция СреднееЗначение(Знач X1, Знач X2, Знач X3) Экспорт

	Возврат (X1 + X2 + X3) / 3;

КонецФункции

// Исходная версия — строго по блок-схеме варианта 3.
// Параметр Ветка передается по ссылке и возвращает пройденный путь.
Функция ВычислитьZ(Знач X1, Знач X2, Знач X3, Ветка) Экспорт

	Xср = СреднееЗначение(X1, X2, X3);

	Если X1 <= Xср Тогда
		Если X2 <= Xср Тогда
			Если X3 <= Xср Тогда
				Ветка = "a-c-e-g-h";
				Z = 0;
			Иначе
				Ветка = "a-c-e-f-h";
				Z = Tan(МодульЧисла(X3));
			КонецЕсли;
		Иначе
			Ветка = "a-c-d-h";
			Z = Cos(X2);
		КонецЕсли;
	Иначе
		Ветка = "a-b-h";
		Z = Sin(X1);
	КонецЕсли;

	Возврат Z;

КонецФункции

// Исправленная версия: проверка типа исходных данных и области определения тангенса.
Функция ВычислитьZИсправленно(Знач X1, Знач X2, Знач X3, Ветка) Экспорт

	Если ТипЗнч(X1) <> Тип("Число") ИЛИ ТипЗнч(X2) <> Тип("Число") ИЛИ ТипЗнч(X3) <> Тип("Число") Тогда
		ВызватьИсключение "Исходные данные должны быть числами";
	КонецЕсли;

	Xср = СреднееЗначение(X1, X2, X3);

	Если X1 <= Xср Тогда
		Если X2 <= Xср Тогда
			Если X3 <= Xср Тогда
				Ветка = "a-c-e-g-h";
				Z = 0;
			Иначе
				Ветка = "a-c-e-f-h";
				Если МодульЧисла(Cos(МодульЧисла(X3))) < 0.000000001 Тогда
					ВызватьИсключение "Tg|X3| не определен (Cos|X3| = 0)";
				КонецЕсли;
				Z = Tan(МодульЧисла(X3));
			КонецЕсли;
		Иначе
			Ветка = "a-c-d-h";
			Z = Cos(X2);
		КонецЕсли;
	Иначе
		Ветка = "a-b-h";
		Z = Sin(X1);
	КонецЕсли;

	Возврат Z;

КонецФункции

// Строковое представление результата с округлением до 6 знаков.
Функция ПредставлениеРезультата(Знач Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат "Z = " + ПредставлениеЧисла(Значение, 6);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Тесты "белого ящика" для варианта 3.
//
// Параметры:
//  ЭтоИсправленнаяВерсия - Булево - тестировать исправленную версию программы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаТестов.
//
Функция ВыполнитьТестыВарианта3(Знач ЭтоИсправленнаяВерсия) Экспорт

	Результат = НоваяТаблицаТестов();

	Для Каждого Тест Из ТестыВарианта3() Цикл

		Ветка = "—";
		Попытка
			Если ЭтоИсправленнаяВерсия Тогда
				Z = ВычислитьZИсправленно(Тест.X1, Тест.X2, Тест.X3, Ветка);
			Иначе
				Z = ВычислитьZ(Тест.X1, Тест.X2, Тест.X3, Ветка);
			КонецЕсли;
			Фактический = ПредставлениеРезультата(Z);
		Исключение
			Фактический = "Ошибка: " + ИнформацияОбОшибке().Описание;
		КонецПопытки;

		ЭтоОшибкаОбнаружена = (Фактический <> Тест.ОжидаемыйРезультат)
			ИЛИ (Ветка <> Тест.ОжидаемаяВетка);

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Номер = Тест.Номер;
		НоваяСтрока.Метод = Тест.Назначение;
		НоваяСтрока.ИсходныеДанные = СтрШаблон("X1 = %1; X2 = %2; X3 = %3", Тест.X1, Тест.X2, Тест.X3);
		НоваяСтрока.ОжидаемаяВетка = Тест.ОжидаемаяВетка;
		НоваяСтрока.ФактическаяВетка = Ветка;
		НоваяСтрока.ОжидаемыйРезультат = Тест.ОжидаемыйРезультат;
		НоваяСтрока.ФактическийРезультат = Фактический;
		НоваяСтрока.РезультатТестирования = ?(ЭтоОшибкаОбнаружена, "Успешно", "Неуспешно");

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Тесты методов структурного покрытия для алгоритма рисунка 1.
// Ожидаемый результат — по правильной схеме (рис. 1, а), фактический — по схеме с ошибками (рис. 1, б).
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаТестов.
//
Функция ВыполнитьТестыРисунка1() Экспорт

	Результат = НоваяТаблицаТестов();
	Номер = 0;

	Для Каждого Тест Из ТестыРисунка1() Цикл

		Номер = Номер + 1;
		ОжидаемыйПуть = "";
		ФактическийПуть = "";
		Ожидаемый = РезультатРисунка1(Ложь, Тест.A, Тест.B, Тест.X, ОжидаемыйПуть);
		Фактический = РезультатРисунка1(Истина, Тест.A, Тест.B, Тест.X, ФактическийПуть);

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Номер = Номер;
		НоваяСтрока.Метод = Тест.Метод;
		НоваяСтрока.ИсходныеДанные = СтрШаблон("A = %1; B = %2; X = %3", Тест.A, Тест.B, Тест.X);
		НоваяСтрока.ОжидаемаяВетка = ОжидаемыйПуть;
		НоваяСтрока.ФактическаяВетка = ФактическийПуть;
		НоваяСтрока.ОжидаемыйРезультат = Ожидаемый;
		НоваяСтрока.ФактическийРезультат = Фактический;
		НоваяСтрока.РезультатТестирования = ?(Ожидаемый <> Фактический, "Успешно", "Неуспешно");

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// В языке 1С нет встроенной функции модуля числа.
Функция МодульЧисла(Знач Число)

	Возврат ?(Число < 0, -Число, Число);

КонецФункции

Функция ПредставлениеЧисла(Знач Число, Знач Точность)

	Возврат Формат(Окр(Число, Точность), "ЧГ=0; ЧН=0");

КонецФункции

Функция НоваяТаблицаТестов()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номер");
	Таблица.Колонки.Добавить("Метод");
	Таблица.Колонки.Добавить("ИсходныеДанные");
	Таблица.Колонки.Добавить("ОжидаемаяВетка");
	Таблица.Колонки.Добавить("ФактическаяВетка");
	Таблица.Колонки.Добавить("ОжидаемыйРезультат");
	Таблица.Колонки.Добавить("ФактическийРезультат");
	Таблица.Колонки.Добавить("РезультатТестирования");
	Возврат Таблица;

КонецФункции

Функция НовыйТестВарианта3(Номер, Назначение, X1, X2, X3, ОжидаемаяВетка, ОжидаемоеЗначение)

	Тест = Новый Структура;
	Тест.Вставить("Номер", Номер);
	Тест.Вставить("Назначение", Назначение);
	Тест.Вставить("X1", X1);
	Тест.Вставить("X2", X2);
	Тест.Вставить("X3", X3);
	Тест.Вставить("ОжидаемаяВетка", ОжидаемаяВетка);
	Тест.Вставить("ОжидаемыйРезультат", ПредставлениеРезультата(ОжидаемоеЗначение));
	Возврат Тест;

КонецФункции

Функция ТестыВарианта3()

	Тесты = Новый Массив;

	Тесты.Добавить(НовыйТестВарианта3(1, "ветка b: Sin(X1)", 5, 1, 3, "a-b-h", -0.958924));
	Тесты.Добавить(НовыйТестВарианта3(2, "ветка d: Cos(X2)", 1, 5, 3, "a-c-d-h", 0.283662));
	Тесты.Добавить(НовыйТестВарианта3(3, "ветка f: Tg|X3|", 1, 2, 6, "a-c-e-f-h", -0.291006));
	Тесты.Добавить(НовыйТестВарианта3(4, "ветка g: Z = 0", 2, 2, 2, "a-c-e-g-h", 0));
	Тесты.Добавить(НовыйТестВарианта3(5, "граница X1 = Xср", 2, 1, 3, "a-c-e-f-h", -0.142547));
