	Тесты.Добавить(НовыйТестВарианта3(8, "ветка g при почти равных X", 2, 2, 2.000001, "a-c-e-f-h", -2.185034));
	Тесты.Добавить(НовыйТестВарианта3(9, "Tg|X3| при |X3| = Pi/2", 0, 0, 1.5707963267949, "a-c-e-f-h",
