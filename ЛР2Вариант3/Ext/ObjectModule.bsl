КонецФункции

// Алгоритм по рис. 1, а.
// Путь по обозначениям методических указаний: a — вход; c/b — первое решение истинно/ложно;
// e/d — второе решение истинно/ложно.
Функция ВычислитьПоПравильнойСхеме(Знач A, Знач B, Знач X, Путь)

	Если A > 1 И B = 0 Тогда
		Путь = Путь + "-c";
		X = X / A;
	Иначе
		Путь = Путь + "-b";
	КонецЕсли;

	Если A = 2 ИЛИ X > 1 Тогда
		Путь = Путь + "-e";
		X = X + 1;
	Иначе
		Путь = Путь + "-d";
	КонецЕсли;

	Возврат X;

КонецФункции

// Алгоритм по рис. 1, б: "И" заменено на "ИЛИ", "X > 1" — на "X < 1".
Функция ВычислитьПоСхемеСОшибкой(Знач A, Знач B, Знач X, Путь)

	Если A > 1 ИЛИ B = 0 Тогда
		Путь = Путь + "-c";
		X = X / A;
	Иначе
		Путь = Путь + "-b";
	КонецЕсли;

	Если A = 2 ИЛИ X < 1 Тогда
		Путь = Путь + "-e";
		X = X + 1;
	Иначе
		Путь = Путь + "-d";
	КонецЕсли;

	Возврат X;

КонецФункции

Функция РезультатРисунка1(Знач ЭтоСхемаСОшибкой, Знач A, Знач B, Знач X, Путь)

	Путь = "a";
	Попытка
		Если ЭтоСхемаСОшибкой Тогда
			Значение = ВычислитьПоСхемеСОшибкой(A, B, X, Путь);
		Иначе
			Значение = ВычислитьПоПравильнойСхеме(A, B, X, Путь);
		КонецЕсли;
	Исключение
		Возврат "Ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;

	Возврат "X = " + ПредставлениеЧисла(Значение, 4);

КонецФункции

Функция НовыйТестРисунка1(Метод, A, B, X)

	Возврат Новый Структура("Метод, A, B, X", Метод, A, B, X);

КонецФункции

Функция ТестыРисунка1()

	Тесты = Новый Массив;

	Тесты.Добавить(НовыйТестРисунка1("Покрытие операторов", 2, 0, 3));

	Тесты.Добавить(НовыйТестРисунка1("Покрытие решений", 3, 0, 2));
	Тесты.Добавить(НовыйТестРисунка1("Покрытие решений", 2, 1, 1));

	Тесты.Добавить(НовыйТестРисунка1("Покрытие условий", 2, 0, 4));
	Тесты.Добавить(НовыйТестРисунка1("Покрытие условий", 1, 1, 0));

	Тесты.Добавить(НовыйТестРисунка1("Покрытие решений/условий", 2, 0, 4));
	Тесты.Добавить(НовыйТестРисунка1("Покрытие решений/условий", 3, 1, 0));
	Тесты.Добавить(НовыйТестРисунка1("Покрытие решений/условий", 0, 0, 0));
	Тесты.Добавить(НовыйТестРисунка1("Покрытие решений/условий", 0, 0, 2));

	Тесты.Добавить(НовыйТестРисунка1("Комбинаторное покрытие условий", 2, 0, 4));
	Тесты.Добавить(НовыйТестРисунка1("Комбинаторное покрытие условий", 2, 1, 1));
	Тесты.Добавить(НовыйТестРисунка1("Комбинаторное покрытие условий", 0.5, 0, 2));
	Тесты.Добавить(НовыйТестРисунка1("Комбинаторное покрытие условий", 1, 0, 1));

	Возврат Тесты;

КонецФункции

