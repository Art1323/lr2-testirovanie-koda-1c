#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	X1 = 1;
	X2 = 2;
	X3 = 6;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РассчитатьZ(Команда)

	ВычислитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТестыВарианта3(Команда)

	ЗаполнитьТестыНаСервере("Вариант3");

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТестыРисунка1(Команда)

	ЗаполнитьТестыНаСервере("Рисунок1");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВычислитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	СреднееXср = Обработка.СреднееЗначение(X1, X2, X3);

	Ветка = "—";
	Попытка
		Если ИсправленнаяВерсия Тогда
			Z = Обработка.ВычислитьZИсправленно(X1, X2, X3, Ветка);
		Иначе
			Z = Обработка.ВычислитьZ(X1, X2, X3, Ветка);
		КонецЕсли;
		РезультатZ = Обработка.ПредставлениеРезультата(Z);
	Исключение
		РезультатZ = "Ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;

	ПройденнаяВетка = Ветка;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТестыНаСервере(Знач ВидТестов)

	Обработка = РеквизитФормыВЗначение("Объект");

	Если ВидТестов = "Рисунок1" Тогда
		Таблица = Обработка.ВыполнитьТестыРисунка1();
		ОписаниеНабора = "Часть 1: алгоритм рисунка 1 (правильная схема против схемы с ошибками)";
	ИначеЕсли ИсправленнаяВерсия Тогда
		Таблица = Обработка.ВыполнитьТестыВарианта3(Истина);
		ОписаниеНабора = "Часть 2, вариант 3: исправленная версия программы";
	Иначе
		Таблица = Обработка.ВыполнитьТестыВарианта3(Ложь);
		ОписаниеНабора = "Часть 2, вариант 3: исходная версия (строго по блок-схеме)";
	КонецЕсли;

	ЗначениеВРеквизитФормы(Таблица, "Тесты");

	КоличествоОбнаруженных = Таблица.НайтиСтроки(Новый Структура("РезультатТестирования", "Успешно")).Количество();
	ИтогТестирования = СтрШаблон("%1. Всего тестов: %2, обнаружили ошибку: %3.",
		ОписаниеНабора, Таблица.Количество(), КоличествоОбнаруженных);

КонецПроцедуры

#КонецОбласти
